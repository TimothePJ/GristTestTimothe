{"nodes": [{"id": "cahier_des_charges_dossier_source_analyse", "label": "Dossier source \u2014 Analyse plateforme Grist bureau d'\u00e9tudes", "file_type": "document", "source_file": "docs/cahier-des-charges/DOSSIER-SOURCE-ANALYSE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "cahier_des_charges_dossier_source_analyse_plateforme", "label": "Plateforme Grist 15 applications", "file_type": "concept", "rationale": "N\u00e9e du remplacement d'une gestion Excel fragile (macros cass\u00e9es, fichiers dupliqu\u00e9s non \u00e0 jour) : une base partag\u00e9e supprime copies et macros par construction. Un seul contributeur, ~20 utilisateurs, 4 projets, service Structure uniquement, extension en cours aux autres services.", "source_file": "docs/cahier-des-charges/DOSSIER-SOURCE-ANALYSE.md", "source_location": "\u00a71-\u00a72", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "cahier_des_charges_dossier_source_analyse_projets2", "label": "Table Projets2 (catalogue des projets)", "file_type": "concept", "source_file": "docs/cahier-des-charges/DOSSIER-SOURCE-ANALYSE.md", "source_location": "\u00a74.2", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "cahier_des_charges_dossier_source_analyse_team", "label": "Table Team (annuaire des collaborateurs)", "file_type": "concept", "source_file": "docs/cahier-des-charges/DOSSIER-SOURCE-ANALYSE.md", "source_location": "\u00a74.2", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "cahier_des_charges_dossier_source_analyse_projectteam", "label": "Table ProjectTeam (affectations projet)", "file_type": "concept", "source_file": "docs/cahier-des-charges/DOSSIER-SOURCE-ANALYSE.md", "source_location": "\u00a74.3", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "cahier_des_charges_dossier_source_analyse_timesegment", "label": "Table TimeSegment (plan de charge pr\u00e9visionnel)", "file_type": "concept", "source_file": "docs/cahier-des-charges/DOSSIER-SOURCE-ANALYSE.md", "source_location": "\u00a74.3", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "cahier_des_charges_dossier_source_analyse_colonnes_sync", "label": "Colonnes-signal *_Sync de Projets2", "file_type": "rationale", "rationale": "L'interrogation p\u00e9riodique 30 s \u00e9tait co\u00fbteuse et en retard d'une demi-minute. Sept colonnes techniques dans Projets2 \u2014 table d\u00e9j\u00e0 charg\u00e9e et surveill\u00e9e par tous les \u00e9crans \u2014 font pousser le signal par Grist : chaque \u00e9cran ne recharge que les tables touch\u00e9es. Polling supprim\u00e9 (intervalle par d\u00e9faut = 0, v\u00e9rifi\u00e9 par tests). \u00c9cart assum\u00e9 : les colonnes sont auto-cr\u00e9\u00e9es (AddColumn), contrairement au principe de non-modification du sch\u00e9ma de l'outil d'acc\u00e8s.", "source_file": "docs/cahier-des-charges/DOSSIER-SOURCE-ANALYSE.md", "source_location": "\u00a74.7 bis", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "cahier_des_charges_dossier_source_analyse_team_moi_identite", "label": "Identification via colonne censur\u00e9e Team.Moi", "file_type": "rationale", "rationale": "Un widget Grist ne peut pas lire l'identit\u00e9 de l'utilisateur. Team.Moi est coch\u00e9e partout mais une r\u00e8gle ACL censure sa lecture sauf sur la ligne dont l'email correspond \u00e0 l'utilisateur : la seule ligne o\u00f9 Moi est lisible identifie l'utilisateur courant. Repli s\u00fbr : aucune ligne identifi\u00e9e = lecture seule.", "source_file": "docs/cahier-des-charges/DOSSIER-SOURCE-ANALYSE.md", "source_location": "\u00a76.5", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "cahier_des_charges_dossier_source_analyse_limite_securite_client", "label": "Limite : cloisonnement calcul\u00e9 c\u00f4t\u00e9 client", "file_type": "rationale", "rationale": "Le filtrage projet/service vit dans le JavaScript des widgets : un utilisateur avec droits directs sur le document peut le contourner. Risque mod\u00e9r\u00e9 tant qu'un seul service et aucun externe n'utilisent la plateforme ; il devient r\u00e9el \u00e0 l'ouverture aux autres services \u2014 ce qui motive le calendrier du document. Le mod\u00e8le Time-Out prouve que la g\u00e9n\u00e9ralisation c\u00f4t\u00e9 serveur est faisable.", "source_file": "docs/cahier-des-charges/DOSSIER-SOURCE-ANALYSE.md", "source_location": "\u00a76.7", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "cahier_des_charges_dossier_source_analyse_services_figes", "label": "Liste des services fig\u00e9e dans le code", "file_type": "rationale", "rationale": "SERVICES = [Structure, Synthese, Topographie] gel\u00e9 dans shared/service-context-core.js : un Team.Service inconnu (ex. M\u00e9thodes) donne un service vide, donc aucun contexte. L'extension \u00e0 un nouveau service exige de modifier la constante, les listes de gestion-equipe et la structure JSON de Projets2.Avancement. \u00c9volution sugg\u00e9r\u00e9e : lire les services depuis une table Grist, comme le registre DOP.", "source_file": "docs/cahier-des-charges/DOSSIER-SOURCE-ANALYSE.md", "source_location": "\u00a76.1 bis", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "cahier_des_charges_dossier_source_analyse_deux_familles_cles", "label": "Deux familles de cl\u00e9s projet sans cl\u00e9 \u00e9trang\u00e8re", "file_type": "rationale", "rationale": "Cinq tables jointes par nom de projet, quatre par num\u00e9ro, sans cl\u00e9 \u00e9trang\u00e8re : renommer un projet propage dans 5 tables, alias multiples par num\u00e9ro, listes de colonnes candidates tol\u00e9rantes (dont UTF-8 mal encod\u00e9), comparaison de num\u00e9ros stricte (2520 \u2260 252035). \u00c9volution recommand\u00e9e : r\u00e9f\u00e9rences Grist stables vers Projets2 et Team.", "source_file": "docs/cahier-des-charges/DOSSIER-SOURCE-ANALYSE.md", "source_location": "\u00a74.4", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "cahier_des_charges_dossier_source_analyse_avancement_json", "label": "Projets2.Avancement \u2014 JSON multi-services en une cellule", "file_type": "rationale", "rationale": "Trois services dans une m\u00eame cellule JSON : aucun cloisonnement possible entre services, risque d'\u00e9crasement en \u00e9criture simultan\u00e9e. La s\u00e9paration propre n\u00e9cessiterait une table avec une ligne par NumeroProjet + Service \u2014 point concret d\u00e8s l'ouverture \u00e0 Synthese et Topographie.", "source_file": "docs/cahier-des-charges/DOSSIER-SOURCE-ANALYSE.md", "source_location": "\u00a74.5", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "cahier_des_charges_dossier_source_analyse_socle_shared", "label": "Socle commun shared/ (5 fichiers, 4 656 lignes)", "file_type": "concept", "rationale": "La logique d'acc\u00e8s, de chargement et de synchronisation est factoris\u00e9e en un socle unique plut\u00f4t que r\u00e9p\u00e9t\u00e9e par application ; le noyau de calcul (service-context-core.js) est s\u00e9par\u00e9 du moteur navigateur (grist-service-context.js) pr\u00e9cis\u00e9ment pour \u00eatre testable hors navigateur \u2014 149 tests sur le socle seul.", "source_file": "docs/cahier-des-charges/DOSSIER-SOURCE-ANALYSE.md", "source_location": "\u00a73.7", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "cahier_des_charges_dossier_source_analyse_segments_demi_jour", "label": "Mod\u00e8le de segments au demi-jour", "file_type": "concept", "rationale": "Convention commune : matin 08:00-12:00, apr\u00e8s-midi 13:00-17:00, week-ends exclus, effectif multiple de 0,5, pas de chevauchement par personne \u2014 partag\u00e9 par gestion-depenses2, planning-synchro et Time-Out.", "source_file": "docs/cahier-des-charges/DOSSIER-SOURCE-ANALYSE.md", "source_location": "\u00a78.2", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "cahier_des_charges_dossier_source_analyse_planning_synchro", "label": "Widget planning-synchro", "file_type": "concept", "rationale": "Remplace deux g\u00e9n\u00e9rations d'architecture \u00e0 deux iframes synchronis\u00e9es par mesure du DOM (d\u00e9synchronisation, \u00e0-coups, instabilit\u00e9) par deux moteurs de rendu dans un document pilot\u00e9 par un contr\u00f4leur unique : l'alignement au pixel devient une propri\u00e9t\u00e9 arithm\u00e9tique vraie par construction. Application la mieux test\u00e9e (19 fichiers de tests) avec harnais de dev sans Grist.", "source_file": "docs/cahier-des-charges/DOSSIER-SOURCE-ANALYSE.md", "source_location": "\u00a77.10", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "cahier_des_charges_dossier_source_analyse_planning_projet", "label": "Widget Planning Projet", "file_type": "concept", "source_file": "docs/cahier-des-charges/DOSSIER-SOURCE-ANALYSE.md", "source_location": "\u00a77.6", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "cahier_des_charges_dossier_source_analyse_gestion_depenses2", "label": "Widget gestion-depenses2", "file_type": "concept", "source_file": "docs/cahier-des-charges/DOSSIER-SOURCE-ANALYSE.md", "source_location": "\u00a77.11", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "cahier_des_charges_dossier_source_analyse_time_out", "label": "Widget Time-Out (cong\u00e9s et absences)", "file_type": "concept", "rationale": "Seule application dont la s\u00e9curit\u00e9 est appliqu\u00e9e c\u00f4t\u00e9 serveur \u2014 la r\u00e9f\u00e9rence \u00e0 g\u00e9n\u00e9raliser. Quatre types d'absence exactement, sans validation ni solde, par choix durable : l'outil sert \u00e0 voir qui est absent, pas \u00e0 approuver.", "source_file": "docs/cahier-des-charges/DOSSIER-SOURCE-ANALYSE.md", "source_location": "\u00a77.8", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "cahier_des_charges_dossier_source_analyse_gestion_user", "label": "Widget Gestion-User (taux d'occupation)", "file_type": "concept", "source_file": "docs/cahier-des-charges/DOSSIER-SOURCE-ANALYSE.md", "source_location": "\u00a77.13", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "cahier_des_charges_dossier_source_analyse_reference2", "label": "Widget Reference2 (suivi des donn\u00e9es d'entr\u00e9e)", "file_type": "concept", "rationale": "Brique \u00e9prouv\u00e9e de la plateforme : plus d'un an d'usage r\u00e9el quotidien, alors que les 14 autres applications n'ont qu'environ un mois et demi de mise \u00e0 disposition.", "source_file": "docs/cahier-des-charges/DOSSIER-SOURCE-ANALYSE.md", "source_location": "\u00a77.1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "cahier_des_charges_dossier_source_analyse_ms_project", "label": "Widget MS Project (import planning travaux)", "file_type": "concept", "rationale": "Seul point d'interface avec un autre service (M\u00e9thodes) ; format XML attendu non document\u00e9 \u2014 un renommage de champ personnalis\u00e9 c\u00f4t\u00e9 M\u00e9thodes peut casser l'import sans pr\u00e9venir.", "source_file": "docs/cahier-des-charges/DOSSIER-SOURCE-ANALYSE.md", "source_location": "\u00a77.7", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "cahier_des_charges_dossier_source_analyse_gestion_equipe", "label": "Widget gestion-equipe (administration \u00e9quipe/projets)", "file_type": "concept", "rationale": "Application la plus puissante : 13 tables en \u00e9criture, renommage/renum\u00e9rotation de projet avec pr\u00e9visualisation obligatoire et signature de contr\u00f4le ; mais aucun contr\u00f4le admin identifi\u00e9 dans le code, aucun journal des modifications de masse, aucun test.", "source_file": "docs/cahier-des-charges/DOSSIER-SOURCE-ANALYSE.md", "source_location": "\u00a77.14", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "cahier_des_charges_dossier_source_analyse_gestion_acces_interservices", "label": "Widget gestion-acces-interservices (administration des affectations)", "file_type": "concept", "rationale": "Refuse de d\u00e9marrer si Team.Projets_Access manque (jamais de modification silencieuse du sch\u00e9ma) et ne supprime jamais une ligne ProjectTeam.", "source_file": "docs/cahier-des-charges/DOSSIER-SOURCE-ANALYSE.md", "source_location": "\u00a77.15", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "cahier_des_charges_dossier_source_analyse_creation_projet", "label": "Widget creation-projet (assistant 5 \u00e9tapes)", "file_type": "concept", "rationale": "Hors filtrage projet/service par choix assum\u00e9 (l'\u00e9cran cr\u00e9e le projet). Pas de transaction atomique : un \u00e9chec partiel peut laisser un projet incomplet.", "source_file": "docs/cahier-des-charges/DOSSIER-SOURCE-ANALYSE.md", "source_location": "\u00a77.2", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "cahier_des_charges_dossier_source_analyse_avancement", "label": "Widget Avancement (tableau de bord)", "file_type": "concept", "source_file": "docs/cahier-des-charges/DOSSIER-SOURCE-ANALYSE.md", "source_location": "\u00a77.9", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "cahier_des_charges_dossier_source_analyse_gestion_globale", "label": "Widget Gestion-globale (vue multiprojets)", "file_type": "concept", "source_file": "docs/cahier-des-charges/DOSSIER-SOURCE-ANALYSE.md", "source_location": "\u00a77.12", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "cahier_des_charges_dossier_source_analyse", "target": "se