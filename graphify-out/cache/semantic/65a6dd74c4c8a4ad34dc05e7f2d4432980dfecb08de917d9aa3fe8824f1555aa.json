{"nodes": [{"id": "specs_2026_08_25_timesegment_mois_design_spec", "label": "Spec TimeSegment passe au mois", "file_type": "document", "source_file": "docs/superpowers/specs/2026-08-25-timesegment-mois-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "specs_2026_08_25_timesegment_mois_design_granularite_mensuelle", "label": "Granularit\u00e9 mensuelle TimeSegment (colonne Mois)", "file_type": "rationale", "rationale": "Un segment couvre exactement un mois : la colonne Mois (Date = 1er du mois) devient la source unique de v\u00e9rit\u00e9, Start_At/End_At ne sont plus \u00e9crites (repli en lecture) ; Effectif est LA charge partout (Allocation_Days \u00e9crite mais plus jamais lue) ; unicit\u00e9 par cl\u00e9 m\u00e9tier (NumeroProjet, Name, Mois) \u2014 un clic sur un mois occup\u00e9 \u00e9dite au lieu de cr\u00e9er.", "source_file": "docs/superpowers/specs/2026-08-25-timesegment-mois-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "specs_2026_08_25_timesegment_mois_design_monthsegments", "label": "Module monthSegments.js (vendoris\u00e9 \u00d73)", "file_type": "concept", "rationale": "Pur, vendoris\u00e9 identique dans gestion-depenses2, planning-synchro et Gestion-User : resolveSegmentMonthKey (Mois puis repli Start_At), getMonthBounds, getMonthBusinessDays, getMonthAvailableDays, getMonthShareForRange (avec repli sur ratio jours ouvr\u00e9s quand dispo(mois)=0 pour ne pas faire dispara\u00eetre la charge d'une personne absente tout le mois).", "source_file": "docs/superpowers/specs/2026-08-25-timesegment-mois-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "specs_2026_08_25_timesegment_mois_design_parite_vendoring", "label": "Parit\u00e9 octet \u00e0 octet des modules vendoris\u00e9s", "file_type": "rationale", "rationale": "shared/tests/vendored-charge-modules-parity.test.cjs verrouille que les copies vendoris\u00e9es de monthSegments.js, leaveAbsences.js et frenchHolidays.js sont identiques octet pour octet entre widgets \u2014 mitigation du risque de divergence des copies dupliqu\u00e9es.", "source_file": "docs/superpowers/specs/2026-08-25-timesegment-mois-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "specs_2026_08_25_timesegment_mois_design_spec", "target": "specs_2026_08_25_timesegment_mois_design_granularite_mensuelle", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-08-25-timesegment-mois-design.md", "source_location": null, "weight": 1.0}, {"source": "specs_2026_08_25_timesegment_mois_design_spec", "target": "specs_2026_08_25_timesegment_mois_design_monthsegments", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-08-25-timesegment-mois-design.md", "source_location": null, "weight": 1.0}, {"source": "specs_2026_08_25_timesegment_mois_design_spec", "target": "specs_2026_08_25_timesegment_mois_design_parite_vendoring", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-08-25-timesegment-mois-design.md", "source_location": null, "weight": 1.0}, {"source": "specs_2026_08_25_timesegment_mois_design_spec", "target": "specs_2026_07_02_planning_synchro_design_table_timesegment", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-08-25-timesegment-mois-design.md", "source_location": null, "weight": 1.0}, {"source": "specs_2026_08_25_timesegment_mois_design_monthsegments", "target": "specs_2026_07_11_charge_leave_aware_design_leaveabsences", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file"